---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg md:p-6" aria-label="Game filters">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="text-2xl font-medium text-slate-100">Filter games</h2>
        <button
          type="button"
          class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-1.5 text-sm font-medium text-slate-200 transition-colors hover:border-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
          data-testid="reset-filters"
        >
          Clear filters
        </button>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <fieldset data-testid="category-filters" class="space-y-3">
          <legend class="mb-2 block text-sm font-medium text-slate-200">Categories</legend>
          <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
              <label
                for={`category-filter-${category.id}`}
                class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500"
              >
                <input
                  id={`category-filter-${category.id}`}
                  type="checkbox"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-blue-500"
                  data-testid={`category-filter-${category.id}`}
                  aria-label={`Filter games by ${category.name}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="space-y-2">
          <label for="publisher-filter" class="block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    <div>
      <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <div class="hidden" data-testid="empty-state-wrapper">
        <EmptyState text="No games match the current filters." />
      </div>
    </div>
  </div>

  <script is:inline>
    const categoryInputs = [...document.querySelectorAll('[data-testid^="category-filter-"]')];
    const publisherSelect = document.querySelector('[data-testid="publisher-filter"]');
    const resetButton = document.querySelector('[data-testid="reset-filters"]');
    const gamesGrid = document.querySelector('[data-testid="games-grid"]');
    const emptyStateWrapper = document.querySelector('[data-testid="empty-state-wrapper"]');
    const gameCards = [...document.querySelectorAll('[data-testid="game-card"]')];

    const syncGameCards = () => {
      const selectedCategoryIds = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => Number(input.value)),
      );
      const selectedPublisherId = publisherSelect && publisherSelect.value ? Number(publisherSelect.value) : null;
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = Number(card.dataset.gameCategoryId || 0);
        const publisherId = Number(card.dataset.gamePublisherId || 0);
        const categoryMatches = selectedCategoryIds.size === 0 || selectedCategoryIds.has(categoryId);
        const publisherMatches = selectedPublisherId === null || publisherId === selectedPublisherId;
        const shouldShow = categoryMatches && publisherMatches;

        card.classList.toggle('hidden', !shouldShow);
        if (shouldShow) {
          visibleCount += 1;
        }
      }

      if (gamesGrid) {
        gamesGrid.classList.toggle('hidden', visibleCount === 0);
      }

      if (emptyStateWrapper) {
        emptyStateWrapper.classList.toggle('hidden', visibleCount !== 0);
      }
    };

    categoryInputs.forEach((input) => {
      input.addEventListener('change', syncGameCards);
    });

    publisherSelect?.addEventListener('change', syncGameCards);

    resetButton?.addEventListener('click', () => {
      categoryInputs.forEach((input) => {
        input.checked = false;
      });

      if (publisherSelect) {
        publisherSelect.value = '';
      }

      syncGameCards();
    });

    syncGameCards();
  </script>
</Layout>
